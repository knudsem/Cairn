@using System.Globalization
@using Microsoft.JSInterop
@inject CairnApiClient Api
@inject PickerState PickerState
@inject ApiWakeUp ApiWakeUp
@inject NavigationManager Nav

@* Préparation d'une commande (docs/PLAN.md, étapes 9 et 10 bis) : la
   prochaine ligne mise en avant, les autres lignes à préparer, puis les
   lignes déjà préparées.
   Affiché par Orders.razor, à droite de la liste sur un écran large, à sa
   place sur un écran étroit. *@

<PageTitle>@(order?.Customer ?? Customer ?? "Commande") - Cairn</PageTitle>

<div class="detail">
    <a class="button button-secondary back-link" href="./">← Commandes</a>

    @{
        var ready = order?.Status == OrderStatus.Ready;
    }

    @* Relecture après l'échec d'une validation, pendant que l'API démarre :
       la commande reste affichée, et le message s'affiche en bas de l'écran,
       sans la décaler (étape 11 bis, app.css). *@
    <p class="status-toast" role="status">@(starting && order is not null ? ApiError.StartingWaitMessage : null)</p>

    @* En-tête : le nom du client en titre, la référence en petit dessous. Le
       titre (h1) est écrit une seule fois, hors des conditions : il reste le
       même élément pendant le chargement puis après, et garde donc le focus
       que OnAfterRenderAsync y place à l'ouverture d'une commande. *@
    <div class="order-head">
        <div class="order-head-title">
            <h1 class="order-title" tabindex="-1" @ref="title">@(order?.Customer ?? Customer ?? "Commande")</h1>
            @if (order is not null)
            {
                <StatusBadge Status="@order.Status" />
            }
        </div>
        @if (order is not null)
        {
            <p class="order-ref">@order.Reference</p>
            <p class="order-progress-text">@Format.Progress(order.PickedCount, order.Lines.Count)</p>
            <span class="progress progress-@Format.StatusClass(order.Status)" aria-hidden="true">
                <span style="width: @Format.Percent(order.PickedCount, order.Lines.Count)"></span>
            </span>
        }
    </div>

    @if (order is null)
    {
        @if (loadError is not null)
        {
            <div class="alert-error" role="alert">
                <h2 class="alert-title">Impossible de charger la commande</h2>
                <p>@loadError.UserMessage</p>
                @if (loadError.Code != "commande_introuvable")
                {
                    <p>Si le problème continue, prévenez votre responsable.</p>
                    <button type="button" class="button button-wide" @onclick="RetryLoadAsync">Réessayer</button>
                }
            </div>
        }
        else
        {
            @* Pendant que l'API démarre, « Cairn démarre » remplace
               « Chargement » (étape 11 bis). *@
            <p class="loading" role="status">@(starting ? ApiError.StartingWaitMessage : "Chargement de la commande...")</p>
            <div class="line-card line-next line-skeleton" aria-hidden="true">
                <span class="skeleton-block"></span>
                <span class="skeleton-block skeleton-wide"></span>
            </div>
        }
    }
    else
    {
        var toPick = order.Lines.Where(l => !l.IsPicked).ToList();
        var picked = order.Lines.Where(l => l.IsPicked).ToList();

        @* Deux colonnes sur un grand écran (à partir de 1280 px) : à gauche,
           ce qu'il faut faire maintenant ; à droite, la suite et ce qui est
           fait. Une seule colonne en dessous. *@
        <div class="detail-columns">
            <div class="detail-main">
                @* Messages après une validation. role="status" : un lecteur
                   d'écran les annonce ; tabindex="-1" permet d'y placer le
                   focus. *@
                @if (ready)
                {
                    <div class="ready-banner" role="status" tabindex="-1" @ref="banner">✓ Commande prête</div>
                    <div class="ready-actions">
                        @if (NextOrderId is { } next)
                        {
                            <a class="button" href="orders/@next">Commande suivante</a>
                        }
                        <a class="button button-secondary" href="./">Retour aux commandes</a>
                    </div>
                }
                else if (success is not null)
                {
                    <p class="banner-success" role="status" tabindex="-1" @ref="banner">✓ @success</p>
                }
                @if (info is not null)
                {
                    <p class="banner-info" role="status" tabindex="-1" @ref="infoBanner">@info</p>
                }

                @if (toPick.Count > 0)
                {
                    @LineCard(toPick[0], true)
                }
            </div>

            <div class="detail-side">
                @if (toPick.Count > 1)
                {
                    <h2 class="section-title">À préparer ensuite (@(toPick.Count - 1))</h2>
                    @foreach (var line in toPick.Skip(1))
                    {
                        @LineCard(line, false)
                    }
                }

                @if (picked.Count > 0)
                {
                    <h2 class="section-title">Déjà préparées (@picked.Count)</h2>
                    <div class="done-grid">
                        @foreach (var line in picked)
                        {
                            <article class="done-card">
                                <span class="done-location">@line.Location</span>
                                <span class="done-product">@line.ProductName</span>
                                <span class="done-meta">Quantité : @line.Quantity</span>
                                @* <bdi> isole le nom : un nom écrit de droite à
                                   gauche ne mélange pas l'ordre des mots. *@
                                <span class="done-by">
                                    <span aria-hidden="true">✓</span>
                                    Préparé par <bdi>@line.PickedBy</bdi>@(line.PickedAt is { } at ? $" à {Format.Time(at)}" : "")
                                </span>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>Commande à afficher.</summary>
    [Parameter, EditorRequired]
    public long OrderId { get; set; }

    /// <summary>Nom du client connu par la liste, affiché pendant le chargement.</summary>
    [Parameter]
    public string? Customer { get; set; }

    /// <summary>
    /// Prochaine commande à préparer (bouton « Commande suivante »), ou null
    /// s'il n'y en a plus.
    /// </summary>
    [Parameter]
    public long? NextOrderId { get; set; }

    /// <summary>
    /// Appelé à chaque nouvel état de la commande (chargement, validation) :
    /// la liste met à jour son statut et son avancement.
    /// </summary>
    [Parameter]
    public EventCallback<Order> OnOrderChanged { get; set; }

    // Commande affichée : null pendant le premier chargement, ou s'il a échoué.
    private Order? order;
    private ApiError? loadError;
    private long? loadedId;
    // Vrai pendant que le chargement attend le démarrage de l'API.
    private bool starting;

    // Validation en cours (identifiant de la ligne), et message après coup.
    private long? pickingLineId;
    private string? success;
    private string? info;
    private long? errorLineId;
    private string? errorTitle;
    private string? errorDetail;

    // Garde contre le double appui : avec des gants, le second appui d'un
    // double appui tomberait sur le bouton « Préparé » de la ligne suivante,
    // qui vient de prendre la place du précédent. Tout appui avant cet
    // instant est ignoré.
    private DateTime ignorePicksUntil;
    private static readonly TimeSpan DoubleTapDelay = TimeSpan.FromMilliseconds(700);

    // Focus à placer au prochain rendu : sur le titre à l'ouverture d'une
    // commande (Blazor ne le fait pas, le composant étant gardé d'une
    // commande à l'autre), sur le bandeau après une validation.
    private ElementReference title;
    private ElementReference banner;
    private ElementReference infoBanner;
    private bool focusTitle;
    private bool focusBanner;
    private bool focusInfo;

    // Le composant est gardé quand l'adresse passe d'une commande à une
    // autre : seul OrderId change. La commande est alors rechargée, et les
    // messages de la précédente effacés.
    protected override async Task OnParametersSetAsync()
    {
        if (OrderId == loadedId)
        {
            return;
        }
        loadedId = OrderId;
        order = null;
        loadError = null;
        starting = false;
        pickingLineId = null;
        success = null;
        info = null;
        ClearLineError();
        focusTitle = true;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusTitle && !focusBanner && !focusInfo)
        {
            return;
        }
        var target = focusBanner ? banner : focusInfo ? infoBanner : title;
        focusTitle = false;
        focusBanner = false;
        focusInfo = false;
        try
        {
            await target.FocusAsync();
        }
        catch (JSException)
        {
            // Un rendu suivant a pu retirer le bandeau entre-temps.
        }
    }

    private async Task LoadAsync()
    {
        var id = OrderId;
        // Profil supprimé depuis un autre onglet (étape 13) : retour à « Qui
        // prépare ? », et la commande ne s'ouvre pas.
        if (await Pages.Pickers.LeaveIfPickerDeletedAsync(Api, PickerState, Nav, ShowStartingAsync))
        {
            return;
        }
        var result = await Api.GetOrderAsync(id, ShowStartingAsync);
        // Pendant l'appel, le préparateur a pu ouvrir une autre commande :
        // la réponse, devenue inutile, est ignorée.
        if (id != OrderId)
        {
            return;
        }
        starting = false;
        if (result.IsSuccess)
        {
            await ShowAsync(result.Value);
            // La commande vient d'apparaître : un double appui sur la carte
            // ou sur « Commande suivante » ne doit pas valider sa première ligne.
            ignorePicksUntil = DateTime.UtcNow + DoubleTapDelay;
        }
        else
        {
            loadError = result.Error;
        }
    }

    // Rappelé par CairnApiClient avant chaque nouvel essai d'une lecture,
    // pendant que l'API démarre : message tout de suite, et réveil de l'API
    // par le navigateur.
    private async Task ShowStartingAsync()
    {
        starting = true;
        StateHasChanged();
        await ApiWakeUp.WakeUpAsync();
    }

    private async Task RetryLoadAsync()
    {
        loadError = null;
        await LoadAsync();
    }

    // Affiche le nouvel état de la commande et le transmet à la liste.
    private async Task ShowAsync(Order value)
    {
        order = value;
        await OnOrderChanged.InvokeAsync(value);
    }

    private async Task PickAsync(OrderLine line)
    {
        // Un appui pendant une validation, ou juste après (double appui), est
        // ignoré : le bouton désactivé à l'écran peut ne pas l'être encore.
        if (pickingLineId is not null || DateTime.UtcNow < ignorePicksUntil || PickerState.Current is not { } picker)
        {
            return;
        }
        var id = OrderId;
        pickingLineId = line.Id;
        // Les bandeaux restent affichés pendant l'appel : les effacer tout de
        // suite ferait sauter la page.
        ClearLineError();

        // Profil supprimé depuis un autre onglet (étape 13) : la ligne n'est
        // pas validée à son nom, et « Qui prépare ? » s'ouvre. L'API, elle,
        // ne connaît que le nom envoyé : c'est l'interface qui vérifie.
        if (await Pages.Pickers.LeaveIfPickerDeletedAsync(Api, PickerState, Nav, ShowStartingAsync))
        {
            return;
        }
        starting = false;

        var result = await Api.PickLineAsync(id, line.Id, picker.Name);
        if (id != OrderId)
        {
            // Une autre commande a été ouverte pendant l'appel : elle ne
            // s'affiche pas, mais la liste suit quand même la validation.
            if (result.IsSuccess)
            {
                await OnOrderChanged.InvokeAsync(result.Value);
            }
            return;
        }
        info = null;
        if (result.IsSuccess)
        {
            await ShowAsync(result.Value);
            Done($"Ligne préparée : {line.Location}");
            return;
        }
        success = null;

        // Toute autre réponse que 200 : la validation a pu être enregistrée
        // quand même (délai dépassé, erreur après l'enregistrement). La
        // commande est relue, et c'est elle qui décide du message.
        var error = result.Error;
        // L'API démarre : la validation n'est pas renvoyée, mais le
        // navigateur réveille l'API. La relecture, elle, attend son
        // démarrage, avec « Cairn démarre » en bas de l'écran.
        if (error.Kind == ApiErrorKind.Starting)
        {
            await ApiWakeUp.WakeUpAsync();
        }
        var reload = await Api.GetOrderAsync(id, ShowStartingAsync);
        starting = false;
        if (id != OrderId)
        {
            if (reload.IsSuccess)
            {
                await OnOrderChanged.InvokeAsync(reload.Value);
            }
            return;
        }
        if (reload.IsSuccess)
        {
            await ShowAsync(reload.Value);
        }
        pickingLineId = null;
        ignorePicksUntil = DateTime.UtcNow + DoubleTapDelay;

        var current = order?.Lines.FirstOrDefault(l => l.Id == line.Id);
        if (reload.IsSuccess && current is { IsPicked: true })
        {
            if (current.PickedBy == picker.Name)
            {
                // Notre validation a bien été enregistrée.
                Done($"Ligne préparée : {line.Location}");
            }
            else
            {
                info = $"Cette ligne a déjà été préparée par {current.PickedBy}.";
                // Le bouton appuyé a disparu avec la ligne : le focus va sur
                // le message.
                focusInfo = true;
            }
            return;
        }

        errorLineId = line.Id;
        if (error.Code == "stock_insuffisant")
        {
            errorTitle = error.Message;
            errorDetail = "La ligne n'est pas validée et le stock n'a pas changé.";
        }
        else if (error.Code == "deja_preparee")
        {
            // Préparée entre-temps, mais la commande n'a pas pu être relue
            // pour dire par qui.
            errorTitle = error.UserMessage;
            errorDetail = "La ligne est déjà validée. Rechargez la commande pour voir par qui.";
        }
        else
        {
            errorTitle = error.UserMessage;
            errorDetail = reload.IsSuccess || error.Kind == ApiErrorKind.Rejected && error.Status < 500
                ? "La ligne n'est pas validée."
                : "La validation n'a peut-être pas été enregistrée : réessayez dans un instant.";
        }
    }

    // Fin d'une validation réussie : message, garde contre le double appui,
    // focus sur le bandeau.
    private void Done(string message)
    {
        pickingLineId = null;
        success = message;
        ignorePicksUntil = DateTime.UtcNow + DoubleTapDelay;
        focusBanner = true;
    }

    // Carte d'une ligne à préparer : la prochaine (isNext), en grand, ou une
    // des suivantes, plus compacte. Une information par ligne, avec son
    // étiquette. C'est un fragment de rendu : un morceau de page écrit en
    // Razor dans le code, comme une petite fonction qui renvoie du JSX en React.
    private RenderFragment LineCard(OrderLine line, bool isNext) =>
        @<article class="line-card @(isNext ? "line-next" : null)"
                  aria-label="@($"{line.ProductName}, emplacement {line.Location}, {line.Quantity} à prendre")">
            @if (isNext)
            {
                @* h2 : le plan des titres reste h1 (client), h2, h3 (produit). *@
                <h2 class="line-kicker">Prochaine ligne</h2>
            }
            <div class="line-main">
                <div class="line-figure">
                    <span class="line-label">Emplacement</span>
                    <span class="line-location">@line.Location</span>
                    @if (LocationWords(line.Location) is { } words)
                    {
                        <span class="line-location-words">@words</span>
                    }
                </div>
                <div class="line-figure line-figure-qty">
                    <span class="line-label">À prendre</span>
                    <span class="line-qty">@line.Quantity</span>
                </div>
            </div>
            <div class="line-product">
                <h3 class="line-product-name">@line.ProductName</h3>
                <span class="line-meta">Réf. @line.Sku</span>
                <span class="line-meta">En stock : @line.StockQty</span>
            </div>
            @if (errorLineId == line.Id)
            {
                <div class="line-error" role="alert">
                    <span class="field-error-icon" aria-hidden="true">!</span>
                    <span>
                        <strong>@errorTitle</strong>
                        <span class="line-error-detail">@errorDetail</span>
                    </span>
                </div>
            }
            <button type="button" class="button @(isNext ? "button-wide" : "button-secondary line-button")"
                    disabled="@(pickingLineId is not null)" @onclick="() => PickAsync(line)">
                @(pickingLineId == line.Id ? "Validation..." : errorLineId == line.Id ? "Réessayer" : "Préparé")
            </button>
        </article>;

    /// <summary>
    /// Emplacement en mots : « B-07-2 » donne « Allée B, rack 7, niveau 2 »,
    /// sans le zéro devant le 7. Un emplacement d'un autre format (pas lettre,
    /// nombre, nombre) donne null : seul le code s'affiche alors.
    /// NumberStyles.None n'accepte que des chiffres : ni signe ni espace.
    /// </summary>
    private static string? LocationWords(string location)
    {
        var parts = location.Split('-');
        if (parts.Length == 3
            && parts[0].Length == 1 && char.IsAsciiLetter(parts[0][0])
            && int.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var rack)
            && int.TryParse(parts[2], NumberStyles.None, CultureInfo.InvariantCulture, out var level))
        {
            return $"Allée {char.ToUpperInvariant(parts[0][0])}, rack {rack}, niveau {level}";
        }
        return null;
    }

    private void ClearLineError()
    {
        errorLineId = null;
        errorTitle = null;
        errorDetail = null;
    }
}
