@page "/pickers"
@using System.Diagnostics.CodeAnalysis
@inject CairnApiClient Api
@inject ApiWakeUp ApiWakeUp
@inject PickerState PickerState
@inject NavigationManager Nav
@inject IConfiguration Configuration
@implements IDisposable

@* Écran « Qui prépare ? » (docs/PLAN.md, étapes 7 bis, 13 et 15) : le
   préparateur choisit son profil, crée le sien ou en supprime un. Un panneau
   centré, avec quatre affichages sur la même adresse : la grille des
   profils, le formulaire « Nouveau profil », la confirmation d'une
   suppression et celle de la remise à zéro de la démo, qui la remplacent
   dans le panneau. La grille a un mode gestion, où toucher une carte propose
   de supprimer le profil au lieu de le choisir. Sous le panneau, à gauche,
   la remise à zéro de la démo (étape 15).

   tabindex="-1" et @onkeydown : un clic dans la page y garde le focus, et la
   touche Échap, qui remonte jusqu'ici, quitte le mode gestion. *@

<div class="page picker-page" tabindex="-1" @onkeydown="OnKeyDown">
    <div class="panel">
        @* Message (étape 13) : succès d'une suppression, ou profil de cet
           onglet supprimé depuis un autre. Le conteneur reste toujours dans la
           page, vide au repos : un lecteur d'écran annonce le texte qui y
           apparaît, sans que le focus y aille. *@
        <div role="status" aria-live="polite">
            @if (notice is not null && !noticeInCorner)
            {
                if (noticeIsSuccess)
                {
                    <p class="banner-success"><span aria-hidden="true">✓</span> @notice</p>
                }
                else
                {
                    <p class="picker-info">@notice</p>
                }
            }
        </div>

        @if (confirming is { } doomed)
        {
            <PageTitle>Supprimer un profil - Cairn</PageTitle>

            <div class="picker-head">
                <span class="picker-avatar picker-confirm-avatar" aria-hidden="true">@doomed.Initial</span>
                @* tabindex="-1" : le titre reçoit le focus à l'ouverture, et un
                   lecteur d'écran lit la question. bdi isole le nom, comme
                   dir="auto" sur les cartes. *@
                <h1 tabindex="-1" @ref="confirmTitle">Supprimer le profil <bdi>@doomed.Name</bdi>&nbsp;?</h1>
                <p class="lead">Les produits qu'il a déjà pris gardent son nom.</p>
            </div>
            @if (deleteError is not null)
            {
                <p class="field-error" role="alert">
                    <span class="field-error-icon" aria-hidden="true">!</span>
                    <span>@deleteError</span>
                </p>
            }
            <div class="form-actions">
                <button type="button" class="button button-danger" disabled="@deleting" @onclick="DeleteAsync">@(deleting ? "Suppression..." : "Supprimer")</button>
                <button type="button" class="button button-secondary" disabled="@deleting" @onclick="CancelDelete">Annuler</button>
            </div>
        }
        else if (!adding)
        {
            <PageTitle>Qui prépare ? - Cairn</PageTitle>

            <div class="picker-head">
                <h1>Qui prépare ?</h1>
                <p class="lead">@(managing ? "Touchez un profil pour le supprimer." : "Choisissez votre nom avant d'ouvrir une commande.")</p>
            </div>

            @if (loadError is not null)
            {
                @* role="alert" : un lecteur d'écran annonce l'erreur dès qu'elle apparaît. *@
                <div class="alert-error" role="alert">
                    <h2 class="alert-title">Impossible de charger les profils</h2>
                    <p>@loadError.UserMessage</p>
                    <p>Si le problème continue, prévenez votre responsable.</p>
                    <button type="button" class="button button-wide" @onclick="RetryAsync">Réessayer</button>
                </div>
            }
            else if (pickers is null)
            {
                @* Pendant que l'API démarre, « Cairn démarre » remplace
                   « Chargement » (étape 11 bis). *@
                <p class="loading picker-status" role="status">@(starting ? ApiError.StartingWaitMessage : "Chargement des profils...")</p>
                @* Emplacements des futures cartes, décoratifs : cachés aux lecteurs d'écran. *@
                <div class="picker-grid" aria-hidden="true">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="picker-card picker-skeleton">
                            <span class="picker-avatar"></span>
                            <span class="picker-skeleton-line"></span>
                        </div>
                    }
                </div>
            }
            else
            {
                @* Liste relue après « Annuler » pendant que l'API démarre :
                   l'ancienne liste reste affichée, et le message s'affiche en
                   bas de l'écran, sans la décaler (app.css). *@
                <p class="status-toast" role="status">@(starting ? ApiError.StartingWaitMessage : null)</p>
                @if (pickers.Count == 0)
                {
                    <p class="picker-status">Aucun profil pour l'instant : ajoutez le vôtre.</p>
                }
                <div class="picker-grid">
                    @foreach (var picker in pickers)
                    {
                        @* La pastille est décorative (aria-hidden) : le nom suffit à
                           un lecteur d'écran. dir="auto" isole le nom : un nom écrit
                           de droite à gauche s'affiche dans son sens. En mode
                           gestion, la carte ouvre la confirmation de la
                           suppression : aria-label le dit, le badge rouge à la
                           croix le montre (décoratif). Hors mode gestion,
                           aria-label vaut null et Blazor ne l'écrit pas. *@
                        <button type="button" class="picker-card @(managing ? "picker-card-managed" : null)" @key="picker.Id"
                                aria-label="@(managing ? $"Supprimer le profil {picker.Name}" : null)"
                                @ref="cardButtons[picker.Id]" @onclick="() => CardClicked(picker)">
                            <span class="picker-avatar" aria-hidden="true">@picker.Initial</span>
                            <span class="picker-name" dir="auto">@picker.Name</span>
                            @if (managing)
                            {
                                <span class="picker-remove-badge" aria-hidden="true">
                                    <svg viewBox="0 0 12 12" focusable="false"><path d="M3.5 3.5l5 5M8.5 3.5l-5 5" /></svg>
                                </span>
                            }
                        </button>
                    }
                    @if (!managing)
                    {
                        <button type="button" class="picker-card picker-card-add" @ref="addButton" @onclick="StartAdding">
                            <span class="picker-avatar" aria-hidden="true">+</span>
                            <span class="picker-name">Ajouter un profil</span>
                        </button>
                    }
                </div>
                @if (pickers.Count > 0)
                {
                    @* aria-pressed : un lecteur d'écran annonce un bouton
                       bascule, enfoncé en mode gestion. *@
                    <div class="picker-manage">
                        <button type="button" class="button @(managing ? null : "button-secondary")"
                                aria-pressed="@(managing ? "true" : "false")" @ref="manageButton" @onclick="ToggleManaging">
                            @(managing ? "Terminé" : "Gérer les profils")
                        </button>
                    </div>
                }
            }
        }
        else
        {
            <PageTitle>Nouveau profil - Cairn</PageTitle>

            <div class="picker-head">
                <h1>Nouveau profil</h1>
                <p class="lead">Votre nom, tel qu'il apparaîtra sur les produits pris.</p>
            </div>

            @* @onsubmit:preventDefault : le navigateur n'envoie pas le formulaire
               lui-même, ce qui rechargerait la page ; CreateAsync s'en charge. La
               touche Entrée dans le champ envoie aussi le formulaire. *@
            <form @onsubmit="CreateAsync" @onsubmit:preventDefault>
                <label class="field-label" for="picker-name">Nom du profil</label>
                @* @bind:event="oninput" : newName suit chaque frappe, et non la
                   sortie du champ ; aria-invalid et aria-describedby relient le
                   message d'erreur au champ, pour un lecteur d'écran. *@
                <input id="picker-name" class="field-input" @ref="nameInput"
                       @bind="newName" @bind:event="oninput"
                       autocomplete="off" autocapitalize="words" spellcheck="false" enterkeyhint="done"
                       aria-invalid="@(formError is null ? "false" : "true")"
                       aria-describedby="@(formError is null ? null : "picker-name-error")" />
                @if (formError is not null)
                {
                    <p id="picker-name-error" class="field-error" role="alert">
                        <span class="field-error-icon" aria-hidden="true">!</span>
                        <span>@formError</span>
                    </p>
                }
                <div class="form-actions">
                    <button type="submit" class="button" disabled="@creating">@(creating ? "Création..." : "Créer")</button>
                    <button type="button" class="button button-secondary" disabled="@creating" @onclick="CancelAsync">Annuler</button>
                </div>
            </form>
        }
    </div>

    @if (ShowDemoReset)
    {
        @* Remise à zéro de la démo (étape 15) : un pied de page discret, en
           bas à droite (Pickers.razor.css), pour ne pas concurrencer le choix
           du profil. La confirmation et le message de succès s'affichent
           dans ce coin, à la place de la zone : le panneau des profils ne
           bouge pas. Masquée en mode gestion, et absente si
           DEMO_RESET_ENABLED ne vaut pas true. *@
        <div class="demo-reset">
            @* Message de succès : role="status", sans focus. Le conteneur
               reste dans la page, vide au repos, comme celui du panneau. *@
            <div role="status" aria-live="polite">
                @if (notice is not null && noticeInCorner)
                {
                    <p class="banner-success"><span aria-hidden="true">✓</span> @notice</p>
                }
            </div>
            @if (confirmingReset)
            {
                @* Petit encadré compact : la question (qui reçoit le focus à
                   l'ouverture), puis « Réinitialiser » et « Annuler ». *@
                <div class="demo-reset-confirm">
                    <p class="demo-reset-question" tabindex="-1" @ref="resetTitle">
                        <strong>Réinitialiser la démo&nbsp;?</strong>
                        <span>Les commandes, le stock et les profils reviennent à leur état de départ. Les profils créés seront supprimés.</span>
                    </p>
                    @if (resetError is not null)
                    {
                        <p class="field-error" role="alert">
                            <span class="field-error-icon" aria-hidden="true">!</span>
                            <span>@resetError</span>
                        </p>
                    }
                    <div class="demo-reset-actions">
                        <button type="button" class="button button-danger" disabled="@resetting" @onclick="ResetAsync">@(resetting ? "Réinitialisation..." : "Réinitialiser")</button>
                        <button type="button" class="button button-secondary" disabled="@resetting" @onclick="CancelReset">Annuler</button>
                    </div>
                </div>
            }
            else
            {
                <div class="demo-reset-row">
                    <p>Vous avez fini de tester ? Remettez la démo à son état de départ.</p>
                    <button type="button" class="button button-secondary" @ref="resetButton" @onclick="AskReset">Réinitialiser la démo</button>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// Page à rouvrir une fois le profil choisi, lue dans l'adresse :
    /// pickers?returnUrl=orders%2F5. Absente, c'est l'accueil.
    /// </summary>
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    // Liste des profils : null tant qu'elle n'est pas chargée, ou si le
    // dernier chargement a échoué (loadError dit alors pourquoi).
    private IReadOnlyList<Picker>? pickers;
    private ApiError? loadError;
    private bool loading;
    // Vrai pendant qu'un chargement attend le démarrage de l'API.
    private bool starting;

    // Formulaire « Nouveau profil ».
    private bool adding;
    private string newName = "";
    private string? formError;
    private bool creating;
    // Heure d'ouverture du formulaire : voir CancelAsync.
    private DateTime addingSince;

    // Confirmation d'une suppression (étape 13) : le profil visé, ou null.
    private Picker? confirming;
    private bool deleting;
    private string? deleteError;
    // Heure d'ouverture de la confirmation : voir DeleteAsync.
    private DateTime confirmingSince;

    // Confirmation de la remise à zéro de la démo (étape 15).
    private bool confirmingReset;
    private bool resetting;
    private string? resetError;
    // Heure d'ouverture de la confirmation : voir ResetAsync.
    private DateTime resetSince;

    // La zone « Réinitialiser la démo » : seulement si la route existe
    // (DEMO_RESET_ENABLED=true, la même variable que l'API), une fois la
    // grille des profils chargée, et hors du mode gestion, du formulaire et
    // de la confirmation d'une suppression.
    private bool ShowDemoReset =>
        Configuration["DEMO_RESET_ENABLED"] == "true"
        && pickers is not null && !managing && !adding && confirming is null;

    // Mode gestion (étape 13) : toucher une carte propose de supprimer le
    // profil, au lieu de le choisir.
    private bool managing;
    // Heure de la dernière entrée dans le mode gestion, ou de la dernière
    // sortie : voir ToggleManaging et CardClicked.
    private DateTime managingToggledAt;

    // Message en haut du panneau, ou null : succès d'une suppression (vert,
    // effacé au bout de SuccessNoticeDuration), ou information (neutre :
    // profil de cet onglet supprimé depuis un autre). Les deux disparaissent
    // dès l'action suivante.
    private string? notice;
    private bool noticeIsSuccess;
    // Vrai pour le message de la remise à zéro, affiché dans son coin.
    private bool noticeInCorner;
    private CancellationTokenSource? noticeTimer;
    private static readonly TimeSpan SuccessNoticeDuration = TimeSpan.FromSeconds(5);

    // Garde contre le double appui (voir CancelAsync, DeleteAsync, CardClicked).
    private static readonly TimeSpan DoubleTapDelay = TimeSpan.FromMilliseconds(500);

    // Éléments qui reçoivent le focus, et focus à placer au prochain rendu.
    private ElementReference nameInput;
    private ElementReference addButton;
    private ElementReference confirmTitle;
    private ElementReference manageButton;
    private ElementReference resetTitle;
    private ElementReference resetButton;
    // Carte de chaque profil, par identifiant : le focus y revient après
    // « Annuler ». Chaque carte a une clé (@key) : Blazor garde ainsi le même
    // élément pour le même profil, même si la liste change.
    private readonly Dictionary<long, ElementReference> cardButtons = [];
    private bool focusNameInput;
    private bool focusAddButton;
    private bool focusConfirmTitle;
    private bool focusManageButton;
    private bool focusResetTitle;
    private bool focusResetButton;
    private long? focusCardOf;

    /// <summary>
    /// Adresse de « Qui prépare ? » qui ramène ensuite à la page actuelle,
    /// par exemple pickers?returnUrl=orders%2F5. Utilisée par le renvoi d'une
    /// page ouverte sans profil, et par le bouton « Changer ».
    /// </summary>
    public static string UrlFor(NavigationManager nav)
    {
        // Adresse de la page actuelle, sans celle du site : orders/5.
        var current = nav.ToBaseRelativePath(nav.Uri);
        return IsSafeReturnUrl(current) ? "pickers?returnUrl=" + Uri.EscapeDataString(current) : "pickers";
    }

    /// <summary>
    /// Vérifie, avant une action, que le profil choisi existe encore (étape
    /// 13) : supprimé depuis un autre onglet, il est oublié, et « Qui prépare
    /// ? » s'ouvre avec un message, puis ramènera à la page actuelle. Rend
    /// vrai dans ce cas : la page appelante s'arrête là. Si l'API ne répond
    /// pas, rend faux : l'action continue, et son propre appel affichera
    /// l'erreur.
    /// </summary>
    public static async Task<bool> LeaveIfPickerDeletedAsync(CairnApiClient api, PickerState state,
        NavigationManager nav, Func<Task>? onStarting)
    {
        if (state.Current is not { } picker)
        {
            return false;
        }
        var exists = await api.PickerExistsAsync(picker, onStarting);
        if (!exists.IsSuccess || exists.Value)
        {
            return false;
        }
        // À l'ouverture de /orders/5, la liste et la commande vérifient en même
        // temps : seule la première oublie le profil et change de page.
        if (state.Current == picker)
        {
            var url = UrlFor(nav);
            state.ClearDeleted();
            nav.NavigateTo(url, replace: true);
        }
        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        // Profil de cet onglet supprimé depuis un autre : le message s'affiche
        // une fois, en haut du panneau, jusqu'à l'action suivante.
        if (PickerState.TakeNotice() is { } deleted)
        {
            ShowNotice(deleted, success: false);
        }
        await LoadAsync();
    }

    public void Dispose() => ClearNotice();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Un élément ne peut recevoir le focus qu'une fois affiché, donc
        // après le rendu : le champ quand le formulaire s'ouvre ou refuse le
        // nom, la carte « Ajouter un profil » au retour à la liste.
        try
        {
            if (focusNameInput)
            {
                focusNameInput = false;
                await nameInput.FocusAsync();
            }
            else if (focusResetTitle)
            {
                focusResetTitle = false;
                await resetTitle.FocusAsync();
            }
            else if (focusResetButton && resetButton.Context is not null)
            {
                // Context est null tant que le bouton n'a jamais été affiché.
                focusResetButton = false;
                await resetButton.FocusAsync();
            }
            else if (focusConfirmTitle)
            {
                focusConfirmTitle = false;
                await confirmTitle.FocusAsync();
            }
            else if (focusManageButton && manageButton.Context is not null)
            {
                // Context est null tant que le bouton n'a jamais été affiché :
                // le drapeau attend alors le rendu qui l'affiche.
                focusManageButton = false;
                await manageButton.FocusAsync();
            }
            else if (focusCardOf is { } id)
            {
                focusCardOf = null;
                if (cardButtons.TryGetValue(id, out var card))
                {
                    await card.FocusAsync();
                }
            }
            else if (focusAddButton)
            {
                focusAddButton = false;
                await addButton.FocusAsync();
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // Un rendu suivant a pu retirer l'élément entre-temps : après
            // « Annuler », un rechargement qui échoue vite remplace la liste
            // par l'encadré d'erreur (JSException). Ou l'élément n'a encore
            // jamais été affiché (InvalidOperationException) : voir
            // focusManageButton et DeleteAsync. Sans ce try, l'exception
            // couperait le circuit Blazor.
        }
    }

    // Charge la liste. Pendant un rechargement, l'ancienne liste reste
    // affichée : pas de clignotement.
    private async Task LoadAsync()
    {
        loading = true;
        loadError = null;
        var result = await Api.GetPickersAsync(ShowStartingAsync);
        starting = false;
        if (result.IsSuccess)
        {
            pickers = result.Value;
            // Plus aucun profil : le bouton « Gérer les profils » disparaît, et
            // le mode gestion avec lui.
            if (pickers.Count == 0)
            {
                managing = false;
            }
        }
        else
        {
            pickers = null;
            loadError = result.Error;
        }
        loading = false;
    }

    // Rappelé par CairnApiClient avant chaque nouvel essai d'une lecture,
    // pendant que l'API démarre : le message s'affiche tout de suite
    // (StateHasChanged redessine la page sans attendre la fin du
    // chargement), et le navigateur réveille l'API.
    private async Task ShowStartingAsync()
    {
        starting = true;
        StateHasChanged();
        await ApiWakeUp.WakeUpAsync();
    }

    private async Task RetryAsync()
    {
        // Un second appui peut arriver avant que le bouton disparaisse de
        // l'écran : il est ignoré pendant un chargement.
        if (loading)
        {
            return;
        }
        ClearNotice();
        pickers = null;
        await LoadAsync();
        // Le bouton « Réessayer » a disparu : le focus va sur la carte
        // « Ajouter un profil » plutôt que de se perdre.
        focusAddButton = pickers is not null;
    }

    // Choisit le profil et ouvre la page demandée. replace: true : le bouton
    // « Retour » du navigateur ne ramène pas à « Qui prépare ? ».
    private void Choose(Picker picker)
    {
        PickerState.Choose(picker);
        Nav.NavigateTo(IsSafeReturnUrl(ReturnUrl) ? ReturnUrl : Nav.BaseUri, replace: true);
    }

    private void StartAdding()
    {
        ClearNotice();
        CloseResetConfirmation();
        adding = true;
        addingSince = DateTime.UtcNow;
        newName = "";
        formError = null;
        focusNameInput = true;
    }

    private async Task CreateAsync()
    {
        // Un second appui (ou la touche Entrée) peut partir avant que le
        // bouton soit désactivé à l'écran : il est ignoré pendant l'appel.
        if (creating)
        {
            return;
        }
        creating = true;
        formError = null;
        var result = await Api.CreatePickerAsync(newName);
        if (result.IsSuccess)
        {
            // Le profil renvoyé par l'API porte le nom enregistré, nettoyé
            // de ses espaces en trop, et non le texte saisi.
            Choose(result.Value);
            return;
        }
        // L'API démarre : la création n'est pas renvoyée, mais le
        // navigateur réveille l'API pour le prochain essai du préparateur.
        if (result.Error.Kind == ApiErrorKind.Starting)
        {
            await ApiWakeUp.WakeUpAsync();
        }
        creating = false;
        formError = result.Error.Code switch
        {
            "profil_existant" => "Ce profil existe déjà : choisissez-le dans la liste.",
            "trop_de_profils" => "20 profils au maximum : choisissez un profil existant.",
            // Nom refusé (400) : le message de l'API dit pourquoi ; sinon,
            // serveur absent, qui démarre ou en erreur.
            _ => result.Error.UserMessage,
        };
        focusNameInput = true;
    }

    private async Task CancelAsync()
    {
        // Avec des gants, le second appui d'un double appui sur « Ajouter un
        // profil » peut toucher « Annuler », qui apparaît dans le même
        // panneau : un appui dans la demi-seconde qui suit l'ouverture est
        // ignoré.
        if (creating || DateTime.UtcNow - addingSince < DoubleTapDelay)
        {
            return;
        }
        adding = false;
        formError = null;
        focusAddButton = true;
        // La liste est relue : elle montre aussi les profils créés entre-temps
        // sur une autre tablette, par exemple celui que « Ce profil existe
        // déjà » désigne.
        await LoadAsync();
    }

    // « Gérer les profils » et « Terminé » : entre dans le mode gestion, ou en
    // sort. Avec des gants, le second appui d'un double appui, sur le même
    // bouton, est ignoré : il annulerait le premier.
    private void ToggleManaging()
    {
        if (DateTime.UtcNow - managingToggledAt < DoubleTapDelay)
        {
            return;
        }
        managing = !managing;
        managingToggledAt = DateTime.UtcNow;
        ClearNotice();
        // La zone de remise à zéro est masquée en mode gestion : sa
        // confirmation éventuelle est abandonnée.
        CloseResetConfirmation();
    }

    // La touche Échap quitte le mode gestion, quand la grille est affichée.
    // Le focus va sur « Gérer les profils », pour ne pas se perdre. Pas de
    // garde contre le double appui ici : il n'existe pas au clavier.
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || !managing || confirming is not null || adding)
        {
            return;
        }
        managing = false;
        ClearNotice();
        focusManageButton = true;
    }

    // Appui sur une carte : en mode gestion, la confirmation de la
    // suppression, et jamais le choix du profil ; sinon, le choix du profil.
    // Un appui dans la demi-seconde qui suit l'entrée dans le mode gestion,
    // ou la sortie, est ignoré : le second appui d'un double appui sur
    // « Gérer les profils » ou « Terminé » ne doit viser aucun profil.
    private void CardClicked(Picker picker)
    {
        if (DateTime.UtcNow - managingToggledAt < DoubleTapDelay)
        {
            return;
        }
        if (managing)
        {
            AskDelete(picker);
        }
        else
        {
            Choose(picker);
        }
    }

    // Ouvre la confirmation de la suppression, sans choisir le profil.
    private void AskDelete(Picker picker)
    {
        confirming = picker;
        confirmingSince = DateTime.UtcNow;
        deleteError = null;
        ClearNotice();
        focusConfirmTitle = true;
    }

    // Retour à la grille, toujours en mode gestion, sans rien supprimer, avec
    // le focus sur la carte d'où l'on vient. Même garde que CancelAsync.
    private void CancelDelete()
    {
        if (deleting || DateTime.UtcNow - confirmingSince < DoubleTapDelay)
        {
            return;
        }
        focusCardOf = confirming?.Id;
        confirming = null;
        deleteError = null;
    }

    // « Réinitialiser la démo » : ouvre la confirmation dans le panneau.
    private void AskReset()
    {
        confirmingReset = true;
        resetSince = DateTime.UtcNow;
        resetError = null;
        ClearNotice();
        focusResetTitle = true;
    }

    // Retour à la grille sans rien changer, avec le focus sur « Réinitialiser
    // la démo ». Même garde que CancelDelete.
    private void CancelReset()
    {
        if (resetting || DateTime.UtcNow - resetSince < DoubleTapDelay)
        {
            return;
        }
        confirmingReset = false;
        resetError = null;
        focusResetButton = true;
    }

    // Ferme la confirmation de la remise à zéro sans rien faire, quand la
    // zone disparaît (mode gestion, formulaire « Nouveau profil »). Pendant
    // l'appel, ResetAsync la ferme lui-même.
    private void CloseResetConfirmation()
    {
        if (!resetting)
        {
            confirmingReset = false;
            resetError = null;
        }
    }

    private async Task ResetAsync()
    {
        // Même protection contre le double appui que DeleteAsync : un appui
        // dans la demi-seconde qui suit l'ouverture est ignoré, comme un
        // second appui pendant l'appel.
        if (resetting || !confirmingReset || DateTime.UtcNow - resetSince < DoubleTapDelay)
        {
            return;
        }
        resetting = true;
        resetError = null;
        var result = await Api.ResetDemoAsync();
        resetting = false;
        if (!result.IsSuccess)
        {
            // L'API démarre : la remise à zéro n'est pas renvoyée, mais le
            // navigateur réveille l'API. Recommencer est sans risque : deux
            // remises à zéro donnent le même résultat.
            if (result.Error.Kind == ApiErrorKind.Starting)
            {
                await ApiWakeUp.WakeUpAsync();
            }
            resetError = $"La démo n'a pas pu être remise à zéro. {result.Error.UserMessage}";
            return;
        }
        confirmingReset = false;
        // La liste est relue : Claire, Romain et Virginie, sans les profils
        // créés.
        await LoadAsync();
        // Le message s'affiche dans le coin de la zone, pas en haut du
        // panneau : rien ne décale les profils.
        ShowNotice("La démo est remise à zéro.", success: true, inCorner: true);
        // Le message est annoncé sans focus (role="status") ; le focus revient
        // sur « Réinitialiser la démo ». Levé après l'appel, comme dans
        // DeleteAsync.
        focusResetButton = true;
    }

    // Affiche le message en haut du panneau, ou dans le coin de la remise à
    // zéro (inCorner). Un succès s'efface seul au bout de
    // SuccessNoticeDuration ; une information reste jusqu'à l'action
    // suivante, le temps de comprendre pourquoi on est revenu ici.
    private void ShowNotice(string message, bool success, bool inCorner = false)
    {
        ClearNotice();
        notice = message;
        noticeIsSuccess = success;
        noticeInCorner = inCorner;
        if (success)
        {
            noticeTimer = new CancellationTokenSource();
            _ = HideNoticeLaterAsync(noticeTimer.Token);
        }
    }

    // Efface le message, et annule son effacement programmé.
    private void ClearNotice()
    {
        notice = null;
        noticeTimer?.Cancel();
        noticeTimer?.Dispose();
        noticeTimer = null;
    }

    // Efface le message au bout de SuccessNoticeDuration, sauf si une action
    // l'a déjà effacé (annulation). La suite de l'attente revient sur le
    // circuit de l'onglet, comme après un appel à l'API : StateHasChanged
    // redessine la page.
    private async Task HideNoticeLaterAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(SuccessNoticeDuration, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        // Annulé juste après la fin de l'attente : un nouveau message l'a
        // remplacé, il ne faut pas l'effacer.
        if (token.IsCancellationRequested)
        {
            return;
        }
        notice = null;
        StateHasChanged();
    }

    private async Task DeleteAsync()
    {
        // Avec des gants, le second appui d'un double appui sur une carte en
        // mode gestion pourrait toucher le « Supprimer » de la confirmation,
        // qui apparaît dans le même panneau, et sauter la confirmation : un
        // appui dans la demi-seconde qui suit l'ouverture est ignoré. Un
        // second appui pendant l'appel aussi.
        if (deleting || confirming is not { } picker || DateTime.UtcNow - confirmingSince < DoubleTapDelay)
        {
            return;
        }
        deleting = true;
        deleteError = null;
        var result = await Api.DeletePickerAsync(picker.Id);
        deleting = false;
        // 404 profil_introuvable : supprimé entre-temps depuis un autre écran.
        // Le résultat voulu est atteint.
        var alreadyDeleted = result.Error is { Kind: ApiErrorKind.Rejected, Code: "profil_introuvable" };
        if (!result.IsSuccess && !alreadyDeleted)
        {
            // L'API démarre : la suppression n'est pas renvoyée, mais le
            // navigateur réveille l'API pour le prochain essai.
            if (result.Error.Kind == ApiErrorKind.Starting)
            {
                await ApiWakeUp.WakeUpAsync();
            }
            deleteError = result.Error.UserMessage;
            return;
        }
        confirming = null;
        // La liste est relue : elle montre aussi les changements faits
        // entre-temps sur une autre tablette. Le mode gestion reste actif,
        // pour supprimer un autre profil, sauf s'il n'en reste aucun.
        await LoadAsync();
        if (alreadyDeleted)
        {
            ShowNotice($"Le profil « {picker.Name} » avait déjà été supprimé.", success: false);
        }
        else
        {
            ShowNotice($"Profil « {picker.Name} » supprimé.", success: true);
        }
        // Le message est annoncé sans y mettre le focus (role="status") : le
        // focus va sur « Terminé », ou sur « Ajouter un profil » s'il ne reste
        // aucun profil. Les drapeaux sont levés après l'appel : Blazor Server
        // appelle OnAfterRenderAsync quand le navigateur a reçu un rendu, et
        // celui de « Suppression... » pourrait sinon les lire trop tôt.
        focusManageButton = managing;
        focusAddButton = !managing;
    }

    /// <summary>
    /// Vrai si returnUrl est une adresse relative du site, comme orders/5 : un
    /// premier caractère lettre ou chiffre, puis seulement des lettres, des
    /// chiffres et les signes / - _ . ? = &amp; % (liste blanche). Une adresse
    /// vers un autre site (https://..., //autre-site, javascript:...) est donc
    /// refusée : sans ce contrôle, un lien piégé pourrait envoyer le
    /// préparateur ailleurs après son choix (redirection ouverte). Un retour
    /// vers « Qui prépare ? » lui-même est refusé aussi.
    /// </summary>
    private static bool IsSafeReturnUrl([NotNullWhen(true)] string? returnUrl) =>
        !string.IsNullOrEmpty(returnUrl)
        && char.IsAsciiLetterOrDigit(returnUrl[0])
        && returnUrl.All(c => char.IsAsciiLetterOrDigit(c) || c is '/' or '-' or '_' or '.' or '?' or '=' or '&' or '%')
        && !returnUrl.StartsWith("pickers", StringComparison.OrdinalIgnoreCase);
}
